# Intentionally vulnerable image for negative security gating tests
# Contains outdated alpine package with known CVEs
FROM alpine:3.14.0

RUN apk update && \
    apk add --no-cache curl=7.79.1-r0 openssl=1.1.1l-r0 bash

LABEL security.test="negative-gating-sample" \
      cve.target="CVE-2022-2068,CVE-2022-2097"

CMD ["/bin/sh", "-c", "echo Vulnerable sample for test harness"]
